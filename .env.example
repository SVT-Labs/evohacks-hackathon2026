# Copy this file to .env.local and fill in the values. Never commit .env.local.

# OpenAI API key (https://platform.openai.com/api-keys). Required unless DEMO_MODE=true.
LLM_API_KEY=

# Model used for report generation. gpt-6-luna is the cheapest current model;
# switch to gpt-6.1-sol for richer analogies at roughly 20x the cost.
LLM_MODEL=gpt-6-luna

# Reasoning effort for reasoning models (none | low | medium | high).
# Lower is faster and cheaper. Remove this line for models without reasoning.
LLM_REASONING_EFFORT=low

# Optional: point at any OpenAI-compatible endpoint instead of api.openai.com.
# LLM_BASE_URL=

# true = /api/generate skips the LLM and returns the cached sample report.
DEMO_MODE=false

# Optional: requests allowed per client IP per minute (default 10).
# RATE_LIMIT_PER_MINUTE=10
